# Configurazione di produzione (mai committata: copia questo file in
# .env.production e riempi i valori veri).
#
#   cp .env.production.example .env.production

# Genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiami-con-una-stringa-casuale-lunga

# Password per la sezione "controlli" dell'app.
CONTROLLI_PASSWORD=cambiami

# Dominio pubblico dell'app, usato dalla label Traefik.
BUBAPP_DOMAIN=bubapp.yoursite-linkbay-cms.com
